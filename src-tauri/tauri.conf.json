{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDV Dr. Cafe",
  "version": "2.6.2",
  "identifier": "br.com.drcafe.pdv",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PDV Dr. Cafe",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "customLanguageFiles": {
          "PortugueseBR": "nsis/PortugueseBR.nsh"
        },
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0NUE0OEIxMUU5RDZEOEMKUldTTWJaMGVzVWhhUkNkSXE0QkRmZS9OYmxkZTk3aU5JR0RjQjlpRjl5VHdhN1ZpdjdCNG1JYVcK",
      "endpoints": [
        "https://github.com/fabianodev2026/pdv-dr-cafe/releases/latest/download/latest.json"
      ]
    }
  }
}
